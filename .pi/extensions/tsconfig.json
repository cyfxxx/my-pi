{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0",
    "typeRoots": [
      "../node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "paths": {}
  },
  "include": [
    "pi-autopilot/**/*.ts",
    "pi-memory/**/*.ts",
    "pi-context/**/*.ts",
    "subagent/**/*.ts",
    "plan-mode/**/*.ts",
    "pi-web-search/**/*.ts",
    "pi-tmux/**/*.ts",
    "pi-voice/**/*.ts",
    "pi-link/**/*.ts",
    "pi-intervention/**/*.ts",
    "pi-mode/**/*.ts"
  ],
  "exclude": [
    "**/tests/**",
    "**/test/**",
    "**/__mocks__/**",
    "pi-browser/**"
  ]
}
