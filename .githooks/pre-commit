#!/bin/bash
# pre-commit — 提交前快检（秒级）
#
# 只跑确定性的结构与注册面守门（golden --fast：跳过 tsc/vitest，那两项在 pre-push 跑全量）。
# 目的：拦住"红了几天没人知道"这类问题（本仓库历史上出现过 tsc 已红但无人察觉）。
# 如需临时跳过：git commit --no-verify（不推荐）。
set -u
# 输出同时落盘（理由见 pre-push：分步日志会被下一次运行覆盖，偶发失败需留证据）
set -o pipefail
LOG="${TMPDIR:-/tmp}/my-pi-golden-precommit.log"

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

if [ ! -f scripts/golden-tasks.sh ]; then
  exit 0
fi

GOLDEN_TIMEOUT="${PI_GOLDEN_TIMEOUT:-600}"  # 提交只跑 --fast，给 10 分钟足够

timeout -k 30 "$GOLDEN_TIMEOUT" bash scripts/golden-tasks.sh --fast 2>&1 | tee "$LOG"
RC=${PIPESTATUS[0]}
if [ "$RC" -eq 124 ] || [ "$RC" -eq 137 ]; then
  echo ""
  echo "pre-commit：golden --fast **超时**（${GOLDEN_TIMEOUT}s）——通常意味着某个测试挂死。"
  echo "完整输出：$LOG；查找残留子进程：pgrep -af 'vitest|golden-tasks|test-'"
  exit 1
fi
if [ "$RC" -ne 0 ]; then
  echo ""
  echo "pre-commit：golden --fast 未通过，提交已阻止。"
  echo "完整输出已保存：$LOG"
  echo "修复后重试；确实需要临时跳过用 git commit --no-verify（不推荐）。"
  exit 1
fi
