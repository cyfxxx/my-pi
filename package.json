{
  "name": "my-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private AI assistant based on Pi",
  "piConfig": {
    "name": "my-pi",
    "configDir": ".my-pi"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "dev": "bash scripts/dev.sh",
    "check": "bash scripts/check-isolation.sh",
