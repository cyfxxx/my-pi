{
	"extends": "../../../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist-custom",
		"rootDir": ".",
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"paths": {
			"@earendil-works/chord": ["../chord/dist/index.d.ts"],
			"@earendil-works/chord/bundler": ["../chord/dist/bundler.d.ts"],
			"@earendil-works/chord/node": ["../chord/dist/node.d.ts"],
			"@earendil-works/pi-agent-core": ["../agent/dist/index.d.ts"],
			"@earendil-works/pi-agent-core/*": ["../agent/dist/*.d.ts"],
			"@earendil-works/pi-ai": ["../ai/dist/index.d.ts"],
			"@earendil-works/pi-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@earendil-works/pi-tui": ["../tui/dist/index.d.ts"],
			"@earendil-works/pi-tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"],
			"@earendil-works/pi-coding-agent": ["../coding-agent/dist/index.d.ts"],
			"@earendil-works/pi-coding-agent/*": ["../coding-agent/dist/*.d.ts"]
		}
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "*/tests/*", "*/test/*", "vitest.config.ts"]
}
