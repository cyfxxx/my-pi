{
	"extends": "../vendor/pi/tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist-custom",
		"rootDir": ".",
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"paths": {
			"@earendil-works/chord": ["../vendor/pi/packages/chord/dist/index.d.ts"],
			"@earendil-works/chord/bundler": ["../vendor/pi/packages/chord/dist/bundler.d.ts"],
			"@earendil-works/chord/node": ["../vendor/pi/packages/chord/dist/node.d.ts"],
			"@earendil-works/pi-agent-core": ["../vendor/pi/packages/agent/dist/index.d.ts"],
			"@earendil-works/pi-agent-core/*": ["../vendor/pi/packages/agent/dist/*.d.ts"],
			"@earendil-works/pi-ai": ["../vendor/pi/packages/ai/dist/index.d.ts"],
			"@earendil-works/pi-ai/*": ["../vendor/pi/packages/ai/dist/*.d.ts", "../vendor/pi/packages/ai/dist/providers/*.d.ts"],
			"@earendil-works/pi-tui": ["../vendor/pi/packages/tui/dist/index.d.ts"],
			"@earendil-works/pi-tui/*": ["../vendor/pi/packages/tui/dist/*.d.ts", "../vendor/pi/packages/tui/dist/components/*.d.ts"],
			"@earendil-works/pi-coding-agent": ["../vendor/pi/packages/coding-agent/dist/index.d.ts"],
			"@earendil-works/pi-coding-agent/*": ["../vendor/pi/packages/coding-agent/dist/*.d.ts"]
		}
	}
}
