{
  "default": "full",
  "modes": {
    "lean": {
      "description": "精简工具面 - 成本敏感的交互会话（去掉 browser/voice/link/autopilot）",
      "features": [
        "web-search",
        "context",
        "memory",
        "mode",
        "plan-mode",
        "intervention",
        "subagent",
        "tmux"
      ],
      "thinking": "low"
    },
    "roleplay": {
      "description": "角色扮演：标枪（秘书舰·已誓约）- 日常交流 + 检索记事（web-search + 隔离记忆）",
      "features": [
        "web-search",
        "memory"
      ],
      "thinking": "low",
      "appendPrompt": "modes/roleplay.md",
      "memoryNamespace": "roleplay",
      "goalMaxRounds": 12
    }
  }
}
